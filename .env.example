# Mode tampilan saat pengembangan (npm run dev):
#   true  = mode contoh: data di browser, tanpa backend, ada pita "Mode contoh" dan akun demo
#   false = mode sungguhan: memanggil backend Laravel
# Hasil `npm run build` SELALU mode sungguhan, apa pun nilai ini.
VITE_USE_MOCK=true
# Alamat API backend untuk pengembangan. Di produksi, kosongkan: bawaannya "/api" (satu domain lewat Nginx).
VITE_API_URL=http://localhost:8000/api
